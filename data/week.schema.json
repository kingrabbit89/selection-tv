{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sélection TV — numéro hebdomadaire",
  "type": "object",
  "required": [
    "schema_version",
    "week",
    "short",
    "range",
    "from",
    "to",
    "theme",
    "pages",
    "page_count"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "week": {
      "type": "string",
      "pattern": "^\\d{4}-S\\d{2}$"
    },
    "short": {
      "type": "string"
    },
    "range": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "format": "date"
    },
    "to": {
      "type": "string",
      "format": "date"
    },
    "theme": {
      "enum": [
        "magazine",
        "archive"
      ]
    },
    "bodyClass": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "hero_image": {
      "type": "string"
    },
    "hero_title": {
      "type": "string"
    },
    "hero_meta": {
      "type": "string"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "className",
          "html"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "className": {
            "type": "string"
          },
          "html": {
            "type": "string"
          }
        }
      }
    }
  }
}