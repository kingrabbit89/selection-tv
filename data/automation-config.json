{
  "schema_version": 1,
  "timezone": "Europe/Paris",
  "generation": {
    "orchestrator": "external-research-agent",
    "scheduled_day": "Thursday",
    "scheduled_time_local": "08:00",
    "target_rule": "Generate the upcoming Saturday-Friday issue in Europe/Paris using scripts/next-target.mjs; on Saturday use that same day.",
    "branch_prefix": "auto/",
    "candidate_manifest_status": "draft",
    "candidate_publication_status": "draft",
    "never_promote_before_green_ci": true,
    "missed_cycle_policy": "Skip unpublished obsolete cycles; keep latest unchanged until the current calendar candidate passes every gate. Never generate backlog editions."
  },
  "review": {
    "scheduled_day": "Friday",
    "scheduled_time_local": "20:00",
    "merge_only_when_required_checks_green": true
  },
  "required_outputs": [
    "data/inventory/YYYY-Sxx.json",
    "data/coverage/YYYY-Sxx.json",
    "data/weeks/YYYY-Sxx.json",
    "data/radar-reserves/YYYY-Sxx.json",
    "semaines/YYYY-Sxx/index.html",
    "data/works.json",
    "data/links.json",
    "data/releases.json",
    "data/manifest.json"
  ],
  "candidate_validation": {
    "week_env": "SELECTION_TV_VALIDATE_WEEK",
    "candidate_flag_env": "SELECTION_TV_CANDIDATE",
    "minimum_raw_inventory_items_per_day": 30,
    "minimum_source_pages_per_day": 2,
    "minimum_overnight_items_per_day": 1,
    "required_checks": [
      "validate-architecture",
      "validate-publication-candidate",
      "validate-editorial",
      "validate-links",
      "validate-freshness",
      "validate-reserves",
      "validate-image-sources",
      "validate-layout",
      "validate-automation"
    ]
  },
  "promotion": {
    "mode": "two-stage-protected-pr",
    "candidate_merge_keeps_issue_private": true,
    "post_merge_validation_workflow": "promote-validated-week.yml",
    "promotion_branch_prefix": "promote/",
    "promotion_pr_only": true,
    "promotion_pr_allowed_files": [
      "data/manifest.json",
      "data/weeks/YYYY-Sxx.json"
    ],
    "promotion_updates_manifest_latest": true,
    "promotion_updates_manifest_status": "published",
    "promotion_updates_week_publication_status": "published",
    "direct_main_push_required": false
  },
  "android_tv": {
    "bridge_protocol": 4,
    "minimum_supported_bridge_protocol": 4,
    "weekly_content_requires_apk_rebuild": false,
    "upstream_repo": "jellyfin/jellyfin-androidtv",
    "upstream_tag": "v0.20.0-beta.3",
    "open_issue_on_new_upstream_release": true
  },
  "phases": {
    "inventory": {
      "scheduled_day": "Thursday",
      "scheduled_time_local": "08:00"
    },
    "enrichment": {
      "scheduled_day": "Friday",
      "scheduled_time_local": "08:00"
    },
    "preflight": {
      "scheduled_day": "Friday",
      "scheduled_time_local": "17:00"
    },
    "publication": {
      "scheduled_day": "Friday",
      "scheduled_time_local": "20:00"
    },
    "retry": {
      "scheduled_day": "Saturday",
      "scheduled_time_local": "08:00"
    }
  },
  "watchdog": {
    "scheduled_day": "Saturday",
    "scheduled_time_utc": "10:00",
    "purpose": "Confirm the Saturday-Friday issue is publicly promoted after the retry window or surface a blocking alert.",
    "recheck_schedule_utc": "20 11-23 * * 6",
    "reconcile_after_publisher": true
  },
  "hybrid": {
    "handoff_schema_version": 1,
    "instructions": "docs/HYBRID-WORKFLOW.md",
    "chat_runtime_migration_verified": false,
    "automatic_quota_failover": false,
    "research_checkpoint": "data/research/YYYY-Sxx.json",
    "import_workflow": "import-editorial-handoff.yml",
    "prepare_workflow": "prepare-editorial-handoff.yml",
    "publisher_workflow": "weekly-publisher.yml",
    "publisher_secret_optional": "WEEKLY_PUBLISH_TOKEN",
    "built_in_token_may_require_workflow_approval": true,
    "keep_agent_fallback_until_full_cycle_verified": true,
    "task_mode": "single-hourly-resumable-agent",
    "legacy_phase_tasks_paused": true,
    "editorial_lease_script": "scripts/editorial-lease.mjs"
  }
}
